{
  "name": "@curtislabs/sleeper-ts",
  "version": "0.3.0",
  "description": "Typed, zero-dependency client for the Sleeper fantasy sports API",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc",
    "test": "vitest run",
    "lint": "eslint src/ scripts/ test/",
    "format": "prettier --write src/ test/ scripts/ README.md CHANGELOG.md",
    "format:check": "prettier --check src/ test/ scripts/ README.md CHANGELOG.md",
    "check:consumer": "npm run build && node scripts/check-consumer.mjs",
    "prepublishOnly": "npm run build"
  },
  "keywords": [
    "sleeper",
    "fantasy",
    "sports",
    "api",
    "sdk",
    "nfl",
    "fantasy-football"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/curtislabs/sleeper-ts.git"
  },
  "homepage": "https://github.com/curtislabs/sleeper-ts#readme",
  "bugs": {
    "url": "https://github.com/curtislabs/sleeper-ts/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.12"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "eslint": "^9.39.2",
    "prettier": "^3.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0",
    "vitest": "^3.2.4"
  }
}
